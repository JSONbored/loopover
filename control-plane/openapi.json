              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "tenant": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "pinnedVersion": {
                          "type": "string",
                          "nullable": true
                        }
                      },
                      "required": [
                        "name"
                      ]
                    },
                    "product": {
                      "type": "string"
                    },
                    "state": {
                      "type": "string",
                      "enum": [
