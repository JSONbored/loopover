                        "nextDueAt"
                      ]
                    },
                    "orbInstallationId": {
                      "type": "integer",
                      "minimum": 0,
                      "exclusiveMinimum": true
                    },
                    "secretRef": {
                      "type": "string"
                    }
                  },
                  "required": [
